# Backend (copy to .env)
ENV_NAME=local
GRAPH_PREFIX=dev_
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false

# Clerk: only CLERK_SECRET_KEY is required (Dashboard → API keys). The API then loads signing keys and each
# user's email from Clerk's Backend API. Optional: set JWKS URL/issuer, or add session-token claims
# {"email": "{{user.primary_email_address}}", "email_verified": "{{user.email_verified}}", "name": "{{user.full_name}}"}
# to skip the per-user lookup.
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

WEB_ORIGIN=http://localhost:3000
INTERNAL_TICK_SECRET=change-me

# LLM (OpenAI-compatible). Set model names to current tool-calling models.
LLM_PRIMARY=openai
LLM_FALLBACK=none
OPENAI_API_KEY=
OPENAI_MODEL_AGENT=
OPENAI_MODEL_FAST=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=

RESEND_API_KEY=
SENTRY_DSN=
