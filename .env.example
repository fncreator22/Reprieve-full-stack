# Backend (copy to .env)
ENV_NAME=local
GRAPH_PREFIX=dev_
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_TLS=false

# Clerk: Dashboard → API keys / JWT. Session token must include custom claims:
#   {"email": "{{user.primary_email_address}}", "email_verified": "{{user.email_verified}}", "name": "{{user.full_name}}"}
CLERK_JWKS_URL=https://<your-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://<your-instance>.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=

WEB_ORIGIN=http://localhost:3000
INTERNAL_TICK_SECRET=change-me

# LLM (OpenAI-compatible). Set model names to current tool-calling models.
LLM_PRIMARY=openai
LLM_FALLBACK=none
OPENAI_API_KEY=
OPENAI_MODEL_AGENT=
OPENAI_MODEL_FAST=
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=
COMPAT_BASE_URL=
COMPAT_API_KEY=
COMPAT_MODEL=

RESEND_API_KEY=
SENTRY_DSN=
